    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid
                ColumnDefinitions="1*,4*"
                ColumnSpacing="10"
                Margin="20,10"
                BackgroundColor="transparent">
                <Image
                    Source="{Binding Icon}"
                    WidthRequest="30"
                    HeightRequest="30" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Text}"
                    FontSize="Medium"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource OffWhite}}"
                    VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>
    <FlyoutItem
        FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate view:MainPage}"
            Route="MainPage">
            <Shell.ItemTemplate>
                <DataTemplate>
                    <templates:FlyoutItem
                        Icon="{AppThemeBinding Light=home.png, Dark=home_dark.png}"
                        Title="Home" />
                </DataTemplate>
            </Shell.ItemTemplate>
        </ShellContent>
        <ShellContent
            Title="Quick 2D"
            Icon="user_fast_running_white.png"
            ContentTemplate="{DataTemplate view:QuickTransform}">
            <Shell.ItemTemplate>
                <DataTemplate>
                    <templates:FlyoutItem
                        Icon="{AppThemeBinding Light=user_fast_running_white.png, Dark=user_fast_running_dark.png}"
                        Title="Quick 2D" />
                </DataTemplate>
