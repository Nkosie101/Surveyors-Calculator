                    <templates:FlyoutItem
                        Icon="{AppThemeBinding Light=recent.png, Dark=recent_dark.png}"
                        Title="Recent" />
                </DataTemplate>
            </Shell.ItemTemplate>
        </ShellContent>
    </FlyoutItem>
    <MenuItem
        Text="Settings"
        IconImageSource="{AppThemeBinding Light=settings.png, Dark=settings_dark.png}"
        Clicked="OnSettingsClicked"></MenuItem>
    <MenuItem
        Text="Other Tools"
        IconImageSource="{AppThemeBinding Light=tool_box_white.png, Dark=tool_box_dark.png}"
        Clicked="OnToolBoxClicked"></MenuItem>
    <MenuItem
        Text="About"
        IconImageSource="{AppThemeBinding Light=recent.png, Dark=recent_dark.png}"
        Clicked="OnAboutClicked"></MenuItem>
</Shell>