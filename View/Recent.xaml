<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    
    xmlns:local="clr-namespace:Surveyors_Calculator"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:viewmodel="clr-namespace:Surveyors_Calculator.ViewModel"
    
    xmlns:model="clr-namespace:Surveyors_Calculator.Model"
    x:DataType="viewmodel:RecentViewModel"
    x:Class="Surveyors_Calculator.View.Recent">
    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsRefreshing}">
        <CollectionView
            ItemsSource="{Binding RecentCalcs}">
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="model:History">
                    <Grid
                        Padding="10">
                        <Border
                            HeightRequest="125">
                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="10, 30, 30, 10" />
                            </Border.StrokeShape>
                            <!--Add the Gesture Recognizer-->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:RecentViewModel}}, x:DataType=viewmodel:RecentViewModel, Path=ToggleRecentCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid
                                Padding="0"
                                ColumnDefinitions="125,*">
                                <Label
                                    Text="{Binding timeCalculated}"
                                    FontSize="Medium"
                                    FontFamily="Segoe"
                                    Padding="10" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Padding="10">
                                    <Label
                                        Text="{Binding file1name}"
                                        FontSize="Medium"
                                        FontFamily="Segoe" />
                                    <Label
                                        Padding="10"
                                        Text="To" />
                                    <Label
                                        Text="{Binding file2name}"
                                        FontSize="Medium"
                                        FontFamily="Segoe" />
                                    <Label
                                        Text="{Binding numberOfPoints}"
                                        FontSize="Small"
                                        FontFamily="Segoe"
                                        HorizontalOptions="End" />
                                    <!--<Label Style="{StaticResource MediumLabel}" Text="{Binding Location}" /> -->
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>