<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    
    xmlns:local="clr-namespace:Surveyors_Calculator"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:viewmodel="clr-namespace:Surveyors_Calculator.ViewModel"
    
    xmlns:model="clr-namespace:Surveyors_Calculator.Model"
    x:DataType="viewmodel:QuickTransform3DViewModel"
    x:Class="Surveyors_Calculator.View.QuickTransform3D">
    <VerticalStackLayout
        Padding="20,0"
        Spacing="10">
        <Label
            x:Name="lbl"
            HorizontalOptions="CenterAndExpand"
            Text="System 1" />
        <StackLayout>
            <Grid
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="50,50,50,50,50">
                <Label
                    Text="First"
                    Padding="10"
                    Grid.Column="0" />
                <Entry
                    Text="{Binding E1Entry}"
                    Placeholder="E 1"
                    Grid.Column="1"></Entry>
                <Entry
                    Text="{Binding N1Entry}"
                    Placeholder="N 1"
                    Grid.Column="2"></Entry>
                <Entry
                    Text="{Binding Z1Entry}"
                    Placeholder="Z 1"
                    Grid.Column="3"></Entry>
                <Label
                    Text="Second"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="1" />
                <Entry
                    Text="{Binding E2Entry}"
                    Placeholder="E 2"
                    Grid.Column="1"
                    Grid.Row="1"></Entry>
                <Entry
                    Text="{Binding N2Entry}"
                    Placeholder="N 2"
                    Grid.Column="2"
                    Grid.Row="1"></Entry>
                <Entry
                    Text="{Binding Z2Entry}"
                    Placeholder="Z 2"
                    Grid.Column="3"
                    Grid.Row="1"></Entry>
                <Label
                    Text="Third"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="2" />
                <Entry
                    Text="{Binding E3Entry}"
                    Placeholder="E 3"
                    Grid.Column="1"
                    Grid.Row="2"></Entry>
                <Entry
                    Text="{Binding N3Entry}"
                    Placeholder="N 3"
                    Grid.Column="2"
                    Grid.Row="2"></Entry>
                <Entry
                    Text="{Binding Z3Entry}"
                    Placeholder="Z 3"
                    Grid.Column="3"
                    Grid.Row="2"></Entry>
                <Label
                    Grid.Column="0"
                    Grid.Row="3"
                    Text="Fourth"
                    Padding="10" />
                <Border
                    Grid.Column="1"
                    Grid.Row="3">
                    <Label
                        Text="{Binding Easting}" />
                </Border>
                <Border
                    Grid.Column="2"
                    Grid.Row="3">
                    <Label
                        Text="{Binding Northing}" />
                </Border>
                <Border
                    Grid.Column="3"
                    Grid.Row="3">
                    <Label
                        Text="{Binding Elevation}" />
                </Border>
            </Grid>
            <Label
                HorizontalOptions="CenterAndExpand"
                Text="System 2" />
            <Grid
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="50,50,50,50,50,50">
                <Label
                    Text="First"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="1" />
                <Entry
                    Text="{Binding E4Entry}"
                    Placeholder="E 4"
                    Grid.Column="1"
                    Grid.Row="1"></Entry>
                <Entry
                    Text="{Binding N4Entry}"
                    Placeholder="N 4"
                    Grid.Column="2"
                    Grid.Row="1"></Entry>
                <Entry
                    Text="{Binding Z4Entry}"
                    Placeholder="Z 4"
                    Grid.Column="3"
                    Grid.Row="1"></Entry>
                <Label
                    Text="Second"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="2" />
                <Entry
                    Text="{Binding E5Entry}"
                    Placeholder="E 5"
                    Grid.Column="1"
                    Grid.Row="2"></Entry>
                <Entry
                    Text="{Binding N5Entry}"
                    Placeholder="N 5"
                    Grid.Column="2"
                    Grid.Row="2"></Entry>
                <Entry
                    Text="{Binding Z5Entry}"
                    Placeholder="Z 5"
                    Grid.Column="3"
                    Grid.Row="2"></Entry>
                <Label
                    Text="Third"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="3" />
                <Entry
                    Text="{Binding E6Entry}"
                    Placeholder="E 6"
                    Grid.Column="1"
                    Grid.Row="3"></Entry>
                <Entry
                    Text="{Binding N6Entry}"
                    Placeholder="N 6"
                    Grid.Column="2"
                    Grid.Row="3"></Entry>
                <Entry
                    Text="{Binding Z6Entry}"
                    Placeholder="Z 6"
                    Grid.Column="3"
                    Grid.Row="3"></Entry>
                <Label
                    Text="Fourth"
                    Padding="10"
                    Grid.Column="0"
                    Grid.Row="4" />
                <Entry
                    Text="{Binding E7Entry}"
                    Placeholder="E 7"
                    Grid.Column="1"
                    Grid.Row="4"></Entry>
                <Entry
                    Text="{Binding N7Entry}"
                    Placeholder="N 7"
                    Grid.Column="2"
                    Grid.Row="4"></Entry>
                <Entry
                    Text="{Binding Z7Entry}"
                    Placeholder="Z 7"
                    Grid.Column="3"
                    Grid.Row="4"></Entry>
                <Button
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Text="Calculate"
                    Command="{Binding Get3DTransformedCoordinatesCommand}" />
                <Label
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"
                    Grid.Row="5"
                    Grid.Column="1"
                    Text="{Binding Length}" />
            </Grid>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>