<?xml version="1.0" encoding="utf-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:local="clr-namespace:Surveyors_Calculator.Templates"
    x:Class="Surveyors_Calculator.Templates.MenuItem"
    x:Name="Root">
    <Grid
        ColumnDefinitions="1*,4*"
        BindingContext="{x:Reference Root}"
        ColumnSpacing="10"
        Margin="20,10">
        <Image
            Source="{Binding Icon}"
            WidthRequest="30"
            HeightRequest="30" />
        <Label
            Grid.Column="1"
            Text="{Binding Text}"
            FontSize="Medium"
            TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource OffWhite}}"
            VerticalTextAlignment="Center" />
    </Grid>
</ContentView>