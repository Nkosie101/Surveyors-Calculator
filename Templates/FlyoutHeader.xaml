<?xml version="1.0" encoding="utf-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Surveyors_Calculator.Templates.FlyoutHeader">
    <Grid
        RowDefinitions="*,40,40"
        ColumnDefinitions="20,70,*">
        <Image
            BackgroundColor="Black"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="3"
            Source="flyout_header.jpg" />
        <StackLayout
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="2"
            VerticalOptions="CenterAndExpand">
            <Frame
                CornerRadius="20"
                BackgroundColor="#eaeaea"
                BorderColor="Black"
                Margin="0"
                Padding="0">
                <ImageButton
                    Source="app_icon_two.png"
                    WidthRequest="70"
                    HeightRequest="70"
                    Aspect="AspectFill" />
            </Frame>
        </StackLayout>
    </Grid>
</ContentView>