<?xml version="1.0" encoding="utf-8"?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    
    xmlns:local="clr-namespace:Surveyors_Calculator"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:viewmodel="clr-namespace:Surveyors_Calculator.ViewModel"
    
    xmlns:model="clr-namespace:Surveyors_Calculator.Model"
    x:Class="Surveyors_Calculator.Popups.MySavePopup"
    Style="{StaticResource MyCustomPopupStyle}">
    <VerticalStackLayout
        Padding="20"
        Spacing="30"
        MinimumWidthRequest="250"
        Style="{StaticResource PopupContainerStyle}">
        <Entry
            Text="{Binding FileName}"
            Placeholder="Name" />
        <Picker
            Title="System / Datum"
            x:Name="coordSystemPicker"
            Grid.Column="2"
            ItemsSource="{Binding CoordinateSystems}"
            SelectedItem="{Binding SelectedCoordSys}"></Picker>
        <Picker
            Title="Units"
            x:Name="unitsPicker"
            Grid.Column="3"
            ItemsSource="{Binding Units}"
            SelectedItem="{Binding SelectedUnits}"></Picker>
        <Label
            Text="{Binding MissingData}" />
        <Button
            Text="OK"
            MinimumWidthRequest="50"
            Command="{Binding OkButtonCommand}" />
    </VerticalStackLayout>
</toolkit:Popup>